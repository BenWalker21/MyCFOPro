## Choose one AI provider for chat/analysis. Keep real keys out of Git.

## Session security (required before production)
SESSION_SECRET=generate_a_long_random_string_here

## Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

## OpenAI (chat + natural TTS voice for Clara)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=nova

## ElevenLabs (optional — most natural Clara voice; overrides OpenAI TTS when set)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_multilingual_v2

## Optional local server port
# PORT=3000

## Public URL (required for OAuth redirect URIs in production)
# APP_BASE_URL=https://your-domain.onrender.com

## CashQueue — QuickBooks Online (Intuit Developer Portal)
# Create app: https://developer.intuit.com/
# Redirect URI: http://localhost:3000/api/cq/qbo/callback (and production URL)
# Scopes: com.intuit.quickbooks.accounting
# INTUIT_CLIENT_ID=your_intuit_client_id
# INTUIT_CLIENT_SECRET=your_intuit_client_secret
# INTUIT_ENVIRONMENT=sandbox

## CashQueue — Gmail (Google Cloud Console)
# Enable Gmail API. OAuth consent screen + credentials (Web application).
# Redirect URI: http://localhost:3000/api/cq/gmail/callback
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

## Account + cloud sync
# User accounts and company data are stored in ./data/ when running npm start.
# Set SESSION_SECRET before deploying to a public server.
