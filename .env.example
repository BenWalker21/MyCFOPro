## Choose one AI provider for chat/analysis. Keep real keys out of Git.

## Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

## OpenAI (chat + natural TTS voice for Clara)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=nova

## ElevenLabs (optional — most natural Clara voice; overrides OpenAI TTS when set)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_multilingual_v2

## Optional local server port
# PORT=3000
